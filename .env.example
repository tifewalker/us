# Copy to .env and fill in (Supabase → Project Settings → API). Both are public
# by design (they ship in the app bundle); RLS protects the data. Never put a
# service-role / secret key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Set to "false" once both real accounts exist (see CLAUDE.md → Lock the door)
# EXPO_PUBLIC_SIGNUPS_OPEN=false

# Web Push (021): public VAPID key (base64url, 65-byte uncompressed P-256). Never put the private key here.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
